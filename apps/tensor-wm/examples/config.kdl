// Tensor's initial configuration is intentionally small and may break while the model evolves.
layout "scrolling-1d" gaps=8 {
    default-column-width proportion=0.5
    master-width proportion=0.55
}

// Regular workspaces participate in normal navigation. Hidden workspaces
// retain live windows without entering that sequence.
workspaces default-count=1 {
    hidden "minimized" minimize-target=#true
    // hidden "communication" show-in-overview=#true
}

// Integer logical-pixel spacing for the compositor-owned overview plan.
overview outer-gap=24 workspace-gap=16

ipc-socket "/run/user/1000/tensor.sock"
// discrete is the default; integrated and any are also valid.
gpu "discrete"
// Optional common Vulkan/tty DRM node; otherwise capability ranking selects the pair.
// render-device "/dev/dri/renderD128"
// auto enables integration when launched by the systemd user manager.
systemd "auto"
// XWayland serves individual X11 applications; Tensor never provides an X11 session.
xwayland #true

appearance {
    // Compositor-owned focus feedback, drawn outside client geometry.
    focus-ring enabled=#true width=4 color="#7fc8ff"
    window-corners radius=12
    // Descriptor-free analytic shadow; remains in the direct output pass.
    window-shadow enabled=#true offset-x=0 offset-y=6 blur-radius=18 spread=0 color="#00000070"
}

// By default Tensor chooses the highest progressive refresh at the panel's native resolution.
// output "HDMI-A-1" mode="2560x1600@239.760" scale=1.25 enabled=#true {
//     position x=0 y=0
// }
// output "eDP-1" enabled=#false

// Arguments are passed directly; shell syntax and expansion are not interpreted.
// spawn-at-startup "waybar"

// environment {
//     clear "GTK_IM_MODULE"
//     set "EDITOR" "hx"
// }

// Cursor syntax and defaults match Niri. Omit either hide node to disable it.
// cursor {
//     xcursor-theme "default"
//     xcursor-size 24
//     hide-when-typing
//     hide-after-inactive-ms 1000
// }
// debug frame-stats=#false force-full-redraw=#false
