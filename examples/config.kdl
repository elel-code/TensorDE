// Tensor's initial configuration is intentionally small and easy to break while the model evolves.
layout "scrolling-1d" {
    gaps 8
    default-column-width proportion=0.5
    master-width proportion=0.55
}
ipc-socket "/run/user/1000/tensor.sock"
// discrete is the default; integrated and any are also valid.
gpu "discrete"
// Optional common Vulkan/Smithay DRM node; otherwise Vulkan capability ranking selects the pair.
// render-device "/dev/dri/renderD128"
// auto enables integration when launched by the systemd user manager.
systemd "auto"
// XWayland serves individual X11 applications; Tensor never provides an X11 session.
xwayland true
// Compositor-owned focus feedback, drawn outside client geometry.
appearance {
    focus-ring {
        enabled true
        width 4
        color "#7fc8ff"
    }
}
// By default Tensor chooses the highest progressive refresh at the panel's native resolution.
// output "HDMI-A-1" {
//     mode "2560x1600@239.760"
//     scale 1.25
// }
// Arguments are passed directly; shell syntax and expansion are not interpreted.
// spawn-at-startup "waybar"
